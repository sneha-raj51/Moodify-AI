PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/moodify?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed origins (e.g. Vercel frontend URL, custom domains; *.vercel.app and localhost are supported automatically)
CORS_ORIGIN=https://moodify-ai.vercel.app,http://localhost:5173
# Base URL of Python ML service (on Render, set to your deployed Python ML service URL: https://<your-ml-service>.onrender.com)
ML_SERVICE_URL=http://127.0.0.1:8000
RATE_LIMIT_WINDOW_MINS=15
RATE_LIMIT_MAX_AUTH=10

# ==============================================================================
# AI COMPANION PROVIDERS CONFIGURATION
# ==============================================================================
# Primary AI Provider ('groq' recommended; fallbacks: 'openai', 'gemini')
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
AI_FALLBACK_PROVIDERS=openai,gemini

# Optional Fallback Providers
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Note: If no external AI provider credentials are valid or reachable,
# Moodify AI automatically falls back to its deterministic multilingual
# (English, Hindi, Hinglish) rule-based music companion engine.

# ==============================================================================
# MUSIC PROVIDERS CONFIGURATION (HYBRID PLAYBACK)
# ==============================================================================
# 1. iTunes Search API:
#    - Official 30-second genuine audio previews for popular catalog songs.
#    - Zero API key required. Always active.
#
# 2. Audius Protocol API:
#    - Official decentralized streaming for legal full-length independent music.
#    - Public API; requires app identifier.
AUDIUS_APP_NAME=MoodifyAI
AUDIUS_API_KEY=
# Optional custom gateway/discovery node (defaults to https://api.audius.co)
AUDIUS_API_BASE=https://api.audius.co

# 3. Jamendo API:
#    - Creative Commons legal full-length music downloads and streams.
#    - Register free at https://developer.jamendo.com to obtain a client ID.
#    - If left blank, Jamendo is gracefully disabled without errors.
JAMENDO_CLIENT_ID=

# ==============================================================================
# SECURE EMAIL DELIVERY (for password resets)
# ==============================================================================
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
