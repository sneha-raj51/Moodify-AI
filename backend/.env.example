PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb://127.0.0.1:27017/moodify
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://yourdomain.com
ML_SERVICE_URL=http://127.0.0.1:8000
RATE_LIMIT_WINDOW_MINS=15
RATE_LIMIT_MAX_AUTH=10

# ==============================================================================
# MUSIC PROVIDERS CONFIGURATION (HYBRID PLAYBACK)
# ==============================================================================
# 1. iTunes Search API:
#    - Official 30-second genuine audio previews for popular catalog songs.
#    - Zero API key required. Always active.
#
# 2. Audius Protocol API:
#    - Official decentralized streaming for legal full-length independent music.
#    - Public API; requires app identifier.
AUDIUS_APP_NAME=MoodifyAI
AUDIUS_API_KEY=
# Optional custom gateway/discovery node (defaults to https://api.audius.co)
AUDIUS_API_BASE=https://api.audius.co

# 3. Jamendo API:
#    - Creative Commons legal full-length music downloads and streams.
#    - Register free at https://developer.jamendo.com to obtain a client ID.
#    - If left blank, Jamendo is gracefully disabled without errors.
JAMENDO_CLIENT_ID=

# ==============================================================================
# SECURE EMAIL DELIVERY (for password resets)
# ==============================================================================
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

