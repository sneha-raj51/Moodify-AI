# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Python Virtual Environments & Bytecode
venv/
.venv/
ml-service/venv/
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*/.pytest_cache/

# Datasets and Large Model Checkpoints (FER2013 weights/data)
ml-service/data/
ml-service/models/*.pth
ml-service/models/*.pt
*.pth
*.pt

# Build and coverage outputs
dist/
dist-ssr/
frontend/dist/
coverage/
*/coverage/

# Environment files and credentials (strict exclusion)
.env
.env.*
!.env.example
!.env.*.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
!frontend/.env.*.example
ml-service/.env
ml-service/.env.*
!ml-service/.env.example
*.local

# Editor directories and OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
scratch/

